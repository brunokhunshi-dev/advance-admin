rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.ativo == true;
    }

    match /administradores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /clientes/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /atividades/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /relatorios/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /assistencia/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /promotores/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /atividades_excluidas/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
